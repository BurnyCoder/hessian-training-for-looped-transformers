# Copy to .env and adjust. All keys are optional; defaults are in src/looped_hessian/config.py.
# Where run outputs (results JSON, logs, figures) are written. Checkpoints go to LH_CHECKPOINT_DIR.
LH_OUTPUT_DIR=results
LH_CHECKPOINT_DIR=checkpoints
# Torch device string.
LH_DEVICE=cuda
# Hugging Face model repo used by `main.py publish` (authentication comes from `hf auth login`, never from this file).
LH_HF_REPO_ID=BurnyCoder/hessian-looped-transformers
LH_GPU_MEM_FRACTION=0.85
